QWidget {
    background-color: #f4f6f9;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    color: #1f2937;
}

QLabel#title {
    font-size: 20px;
    font-weight: bold;
    color: #111827;
    padding-bottom: 6px;
}

QPushButton {
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
}

QPushButton#aboutBtn {
    background-color: #4b5563;
}

QPushButton#aboutBtn:hover {
    background-color: #374151;
}

QLineEdit {
    background-color: white;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 10px;
}

QLineEdit:focus {
    border: 1px solid #2563eb;
}

QTableWidget {
    background-color: white;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    gridline-color: #e5e7eb;
}

QHeaderView::section {
    background-color: #e2e8f0;
    color: #1e293b;
    font-weight: bold;
    padding: 6px;
    border: none;
}